
name: System Report

on: push

jobs:
  system-info:
    name: System Information
    runs-on: ubuntu-latest

    steps:
      - name: Print OS and Kernel
        run: |
          echo "Operating System:"
          cat /etc/os-release
          echo "Kernel Version:"
          uname -r

      - name: Print Free Disk Space
        run: df -h

      - name: Print Current Date and Time
        run: date

      - name: Install tree
        run: |
          sudo apt-get update
          sudo apt-get install tree -y

      - name: Display Home Directory Structure
        run: tree -L 2 "$HOME"

  tool-check:
    name: Tool Check
    runs-on: ubuntu-latest

    steps:
      - name: Install jq
        run: |
          sudo apt-get update
          sudo apt-get install jq -y

      - name: Create JSON Report
        run: |
          cat > report.json <<EOF
          {
            "project": "System Report",
            "status": "Success",
            "environment": "GitHub Actions"
          }
          EOF

      - name: Read JSON Value using jq
        run: |
          jq '.status' report.json

      - name: Print Installed Tool Versions
        run: |
          python3 --version
          git --version
          jq --version

      - name: Finish Report
        run: echo "Report complete"

